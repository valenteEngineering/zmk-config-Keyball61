#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6
#define QWRT    7
#define BT      8

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    macros {
        #if __has_include("secrets.dtsi")
#include "secrets.dtsi"
#else
#include "secrets.example.dtsi"
#endif

        vim_paste: vim_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp DOUBLE_QUOTES &kp PLUS &kp P>;
        };

        vim_yank: vim_yank {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp DOUBLE_QUOTES &kp PLUS &kp Y>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DVRK";
            bindings = <
&kp ESC         &kp N1    &kp N2     &kp N3        &kp N4  &kp N5                                         &kp N6     &kp N7  &kp N8  &kp N9  &kp N0            &kp MINUS
&kp TAB         &kp SQT   &kp COMMA  &kp DOT       &kp P   &kp Y                                          &kp F      &kp G   &kp C   &kp R   &kp L             &kp FSLH
&kp ESC         &kp A     &kp O      &kp E         &kp U   &kp I                                          &kp D      &kp H   &kp T   &kp N   &kp S             &kp BACKSLASH
&kp LEFT_SHIFT  &kp SEMI  &kp Q      &kp J         &kp K   &kp X   &kp END           &mt RIGHT_WIN ENTER  &kp B      &kp M   &kp W   &kp V   &kp Z             &kp RIGHT_SHIFT
&trans          &trans    &kp DOWN   &kp UP_ARROW  &mo 6   &mo 2   &kp LEFT_CONTROL  &kp BACKSPACE        &kp SPACE                          &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;
        };

        number_layer {
            bindings = <
&trans  &kp N1    &kp N2    &kp N3  &kp N4     &kp N5                  &kp N6     &kp N7  &kp N8  &kp N9  &kp N0  &tog 8
&trans  &trans    &trans    &trans  &trans     &trans                  &kp LC(A)  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans                  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &trans                             &trans  &trans
            >;

            label = "NUM";
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans                         &trans  &trans  &trans         &trans       &trans          &kp LC(LA(DEL))
&trans  &trans  &trans  &trans  &vim_paste  &vim_yank                      &trans  &trans  &trans         &kp LS(F10)  &trans          &trans
&trans  &trans  &trans  &trans  &trans      &trans                         &trans  &trans  &kp LC(LA(T))  &trans       &trans          &trans
&mo 1   &trans  &trans  &trans  &trans      &trans     &trans  &trans      &trans  &trans  &trans         &trans       &trans          &trans
&trans  &trans  &trans  &trans  &trans      &trans     &trans  &kp DELETE  &trans                                      &kp LEFT_ARROW  &kp RIGHT
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                  &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_NEXT      &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &kp LC(LA(F1))  &kp LC(LA(F2))    &kp LC(LA(F3))  &kp LA(F4)    &trans        &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                  &kp LC(LA(T))   &kp LC(LA(DEL))   &kp LS(F10)     &kp LA(I)     &trans        &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans          &trans            &trans          &trans        &trans        &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                                                          &trans        &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                        &trans  &trans     &trans     &trans     &trans  &mo 5
&trans  &trans  &trans  &trans  &trans     &trans                        &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK                     &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mkp MCLK  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mo 5      &trans  &mo 3                                    &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        qwerty_layer {
            label = "QWRT";
            bindings = <
&kp ESC         &kp N1     &kp N2        &kp N3        &kp N4  &kp N5                                   &kp N6           &kp N7  &kp N8     &kp N9   &kp N0         &kp BSPC
&kp TAB         &kp Q      &kp W         &kp E         &kp R   &kp T                                    &kp Y            &kp U   &kp I      &kp O    &kp P          &kp BACKSLASH
&kp CAPS        &kp A      &kp S         &kp D         &kp F   &kp G                                    &kp H            &kp J   &kp K      &kp L    &kp SEMI       &kp SQT
&kp LEFT_SHIFT  &kp Z      &kp X         &kp C         &kp V   &kp B        &kp PAGE_DOWN  &kp PAGE_UP  &kp N            &kp M   &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
&none           &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &mo 6   &lt 4 SPACE  &mo 5          &kp ENTER    &lt 2 BACKSPACE                              &kp RIGHT_ALT  &kp DELETE
            >;
        };

        bluetooth_layer {
            label = "BT";
            bindings = <
&trans  &trans        &trans          &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &tog 1
&trans  &out OUT_USB  &out OUT_BLE    &out OUT_TOG  &bt BT_PRV    &bt BT_NXT                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans          &trans        &trans        &trans        &trans  &trans  &trans                          &trans  &trans
            >;
        };
    };
};
